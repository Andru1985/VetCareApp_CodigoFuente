<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Galería de Fotos - Pacientes e Instalaciones"
        android:textStyle="bold"
        android:textColor="#1A2744"
        android:paddingBottom="8dp" />

    <ListView
        android:id="@+id/listFotos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/tvDescripcionFoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:padding="10dp"
        android:background="#EAF4F1"
        android:text="Selecciona una imagen para ver su descripción detallada." />

</LinearLayout>
