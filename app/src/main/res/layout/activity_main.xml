<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🐾 VetCare"
            android:textColor="#17324D"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔"
            android:textSize="24sp"
            android:padding="8dp" />

    </LinearLayout>

    <!-- CONTENIDO DE LOS FRAGMENTS -->
    <FrameLayout
        android:id="@+id/frameContenido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <!-- MENÚ INFERIOR -->
    <LinearLayout
        android:id="@+id/menuInferior"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- PERFIL -->
        <TextView
            android:id="@+id/btnPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤\nPerfil"
            android:textColor="#17324D"
            android:textSize="11sp" />

        <!-- FOTOS -->
        <TextView
            android:id="@+id/btnFotos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📷\nFotos"
            android:textColor="#17324D"
            android:textSize="11sp" />

        <!-- VIDEOS -->
        <TextView
            android:id="@+id/btnVideo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎥\nVideos"
            android:textColor="#17324D"
            android:textSize="11sp" />

        <!-- AGENDAR CITA -->
        <TextView
            android:id="@+id/btnCitas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📅\nAgendar"
            android:textColor="#17324D"
            android:textSize="11sp" />

        <!-- MIS CITAS -->
        <TextView
            android:id="@+id/btnMisCitas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📋\nMis citas"
            android:textColor="#17324D"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- MenuFragment existente -->
    <fragment
        android:id="@+id/fragmentMenu"
        android:name="com.grancolombiano.vetcareapp.MenuFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>