<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">

        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="2dp"
                android:color="#1976D2" />

            <corners android:radius="12dp" />

            <padding
                android:left="12dp"
                android:top="8dp"
                android:right="12dp"
                android:bottom="8dp" />

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="1dp"
                android:color="#CFD8DC" />

            <corners android:radius="12dp" />

            <padding
                android:left="12dp"
                android:top="8dp"
                android:right="12dp"
                android:bottom="8dp" />

        </shape>

    </item>

</selector>